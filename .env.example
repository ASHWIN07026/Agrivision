APP_ENV=development
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Frontend-only publishable credentials. Never place the service-role key in Vite variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATA_GOV_IN_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
DISEASE_MODEL_PATH=models/disease/disease_mobilenetv2.keras
YIELD_MODEL_PATH=models/yield/faostat_random_forest_yield.joblib
DISEASE_CONFIDENCE_THRESHOLD=0.70
FRONTEND_URL=http://localhost:5173

# Own marketplace: publishing key stays on the server. Use a persistent disk path in production.
MARKETPLACE_ADMIN_KEY=
MARKETPLACE_DB_PATH=
